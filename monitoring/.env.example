# cp .env.example .env && chmod 600 .env, then fill in.
# Domain of this server (A record → its IP); Caddy gets the certificate by itself.
STATS_DOMAIN=stats.example.com
# Grafana login: admin / this password.
GRAFANA_ADMIN_PASSWORD=change-me
# Credentials the coordinator pushes with (metrics.push in its config.yaml).
METRICS_USER=vpn
METRICS_PASSWORD=change-me-too
